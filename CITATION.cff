    given-names: Bairui
    orcid: "https://orcid.org/0000-0002-2240-5418"
    affiliation: "Department of Computational Biology and Medical Sciences, Graduate School of Frontier Sciences, The University of Tokyo"
  - family-names: Kiryu
    given-names: Hisanori
    orcid: "https://orcid.org/0000-0003-3554-5353"
    affiliation: "Department of Computational Biology and Medical Sciences, Graduate School of Frontier Sciences, The University of Tokyo"
